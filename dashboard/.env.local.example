# セッション署名鍵(HMAC)。openssl rand -hex 32 等で生成。
SESSION_SECRET=
# TOTPシークレットの暗号化鍵(AES-256-GCM)。32byteの hex文字列。
# 生成: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=
# 招待メール・パスワード再設定メール内のリンクに使うベースURL。
APP_BASE_URL=http://localhost:3000
# Neon Postgres(Vercel Marketplace経由)の接続文字列。`vercel env pull`で自動取得される。
DATABASE_URL=

BACKEND_API_URL=http://localhost:8000
BACKEND_API_TOKEN=

# Gmail連携(/settings/gmail, 2026-08-16)。web-engagement-tool(MA)と同じGoogle Cloud
# OAuthクライアントを共用する(Google Cloud Consoleの同じクライアントに、本アプリ用の
# リダイレクトURI `${APP_BASE_URL}/gmail/oauth/callback` を追加登録しておくこと)。
# crm-sfa-integration(Python backend)側のconfig/.env.exampleの同名変数と同じ値。
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# 招待・パスワード再設定・2FAコード送信用SMTP設定(任意、未設定時はサーバーログに
# リンク/コードが出力される)。
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# アイコン画像アップロード(/settings/profile, 2026-08-16)。Vercel Blobのストア作成/
# 環境変数の自動注入は`vercel blob create-store`で行う(未実施 — 実施後に
# `vercel env pull`で自動取得される。手動でここに値を書く必要はない)。
BLOB_READ_WRITE_TOKEN=
