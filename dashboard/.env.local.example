# セッション署名鍵(HMAC)。openssl rand -hex 32 等で生成。
SESSION_SECRET=
# TOTPシークレットの暗号化鍵(AES-256-GCM)。32byteの hex文字列。
# 生成: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=
# 招待メール・パスワード再設定メール内のリンクに使うベースURL。
APP_BASE_URL=http://localhost:3000
# Neon Postgres(Vercel Marketplace経由)の接続文字列。`vercel env pull`で自動取得される。
DATABASE_URL=

BACKEND_API_URL=http://localhost:8000
BACKEND_API_TOKEN=

# 招待・パスワード再設定・2FAコード送信用SMTP設定(任意、未設定時はサーバーログに
# リンク/コードが出力される)。
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
