// Prisma schema for the crm-sfa-integration project's shared Postgres
// (Neon, provisioned 2026-08-15). Originally scoped to just the dashboard's
// own auth/security data (user accounts, 2FA, IP allowlist), ported from
// web-engagement-tool's prisma/schema.prisma — same models, same field
// names, so the two admin surfaces stay familiar to whoever maintains both.
//
// 2026-08-16, Gmail連携移管(gmail_sync)に伴いRepGmailConnection/EmailLogを追加。
// この2モデルは主にPythonバックエンド(src/gmail_sync/)がpsycopgで直接読み書きする
// (Python側は独自のマイグレーションツールを持たず、このNeon DBのスキーマ管理は
// Prisma/dashboardに一本化する設計 — 同一DBに対する二重のマイグレーション履歴を
// 避けるため)。連絡先・案件等の業務データは引き続きNotion側(Python backend経由、
// BACKEND_API_URL)が正であり、このDBはあくまでダッシュボードの認証・Gmail連携の
// 実務データ置き場という位置付け。

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  master
  editor
  viewer
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  // Null while an invited user hasn't set their password yet.
  passwordHash String?
  role         UserRole @default(viewer)
  createdAt    DateTime @default(now())

  // アクセス権限用のroleとは別軸(2026-08-16、src/incident_detection/)。高優先度インシデント
  // 検知の即時Slack DM通知先を、ハードコード/env変数ではなく動的にDBから解決するために追加。
  // trueに設定されたUserのemail一覧をnotify_managers_immediate()が通知先とする
  // (src/incident_detection/db.pyのfind_manager_emails()参照)。
  isManager Boolean @default(false)

  // 自己プロフィール編集(/settings/profile, 2026-08-16)で追加。どちらも任意項目 —
  // 未設定でも既存ユーザーの動作に影響しない。
  name      String?
  avatarUrl String?

  // 役職・部署名(2026-08-18)。web-engagement-tool側と同じ追加、どちらも任意項目。
  title      String?
  department String?

  // TOTP two-factor auth (only relevant when AppSettings.twoFactorEnabled is
  // on). totpSecretEnc is set once the user completes enrollment; until
  // then totpEnabled stays false and login forces them through the
  // enrollment flow instead of straight into the app.
  totpSecretEnc       String?
  totpEnabled         Boolean  @default(false)
  // One-time recovery codes (hashed like a password, same scrypt scheme) for
  // when the user loses their authenticator device. Consumed entries are
  // removed from the array.
  totpBackupCodesHash String[] @default([])

  // Email one-time-code two-factor auth — the alternative to TOTP a user can
  // pick during enrollment. Mutually exclusive with totpEnabled in practice
  // (a user only ever completes one enrollment flow), but nothing here
  // enforces that at the schema level.
  emailOtpEnabled Boolean @default(false)

  resetTokens       PasswordResetToken[]
  emailChangeTokens EmailChangeToken[]
}

// One-time code issued for email-based 2FA login. Old/expired rows aren't
// cleaned up automatically; volume is low enough not to matter.
model EmailOtpCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// メールアドレス変更(/settings/profile, 2026-08-16)の本人確認用ワンタイムトークン。
// PasswordResetTokenと同じワンタイムトークン方式だが、確定先が「ログイン中のuserId」
// ではなく「これから確定するnewEmail」である点が違う — 即時上書きせず、新しいメール
// アドレス宛にリンクを送って本人がクリックするまでUser.emailは変更しない安全設計。
model EmailChangeToken {
  id        String    @id @default(cuid())
  userId    String
  newEmail  String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Singleton row (id always 1) — org-wide security policy toggles. Both
// default OFF so the initial rollout doesn't lock anyone out until a master
// explicitly turns them on from /settings/security.
model AppSettings {
  id                 Int      @id @default(1)
  twoFactorEnabled   Boolean  @default(false)
  ipAllowlistEnabled Boolean  @default(false)
  // Allowed IPv4 addresses or CIDR blocks (e.g. "203.0.113.5",
  // "203.0.113.0/24"). Only enforced (in proxy.ts) when ipAllowlistEnabled
  // is true. lib/ipAllowlist.ts's ALWAYS_ALLOWED_IPS is unioned in on top of
  // this at check time regardless of what's here.
  ipAllowlist        String[] @default([])
  updatedAt          DateTime @updatedAt

  // 未返信メールリマインド(2026-08-16、src/email_reminders/)。デフォルトOFF・閾値未選択
  // で導入する(既存のtwoFactorEnabled/ipAllowlistEnabledと同じ、初期ロールアウトで誰にも
  // 意図せずSlack DMが飛ばないようにするための設計)。
  emailReminderEnabled        Boolean @default(false)
  // 有効な閾値(時間単位、3刻みで3〜72の範囲を想定、例: [3, 6, 24])。
  // src/email_reminders/reminder_check.pyがこの配列のみを見て判定する。
  emailReminderThresholdHours Int[]   @default([])
}

// 未返信メールリマインド(2026-08-16、src/email_reminders/)の送信済み記録。EmailLogの
// どの受信メールに対して、どの閾値でリマインドを送ったかを保持し、同じ組み合わせでの
// 二重送信を防ぐ(@@unique)。EmailLog側が削除されたら追随して削除してよい記録のため
// onDelete: Cascade。このテーブルの読み書きもEmailLog同様、Python側(psycopg直接アクセス、
// src/email_reminders/db.py)が行う。
model EmailReminderLog {
  id             String   @id @default(cuid())
  emailLogId     String
  thresholdHours Int
  sentAt         DateTime @default(now())

  emailLog EmailLog @relation(fields: [emailLogId], references: [id], onDelete: Cascade)

  @@unique([emailLogId, thresholdHours])
}

// 営業担当ごとのGmail OAuth接続(2026-08-16、Gmail連携移管)。web-engagement-tool側の
// RepCalendarConnectionと同じ暗号化リフレッシュトークン方式(AES-256-GCM、
// lib/tokenCrypto.ts / src/gmail_sync/token_crypto.py — 同じTOKEN_ENCRYPTION_KEYを
// 両言語から使う)。接続UIはdashboard(Next.js)側にあるが、実際にこのテーブルを
// 定期的にポーリングしてGmail APIを叩くのはPythonバックエンド側(src/gmail_sync/)。
// 2026-08-16、Gmail Push通知(users.watch() + Cloud Pub/Sub)によるほぼリアルタイム同期化に
// 伴いhistoryId/watchExpirationを追加。Zoho watch channel(ZOHO_WATCH_CHANNEL_ID、env変数で
// 1本管理)と異なり、Gmailのwatch()は担当者(メールボックス)ごとに個別のため、行ごとに
// DBで状態管理する(src/gmail_sync/watch_registration.py参照)。
model RepGmailConnection {
  id              String    @id @default(cuid())
  repEmail        String    @unique
  refreshTokenEnc String
  connectedAt     DateTime  @default(now())
  lastSyncedAt    DateTime?
  // Gmail APIのhistoryId(増分取得の起点)。未設定(null)の担当者は、Pushがまだ登録されて
  // いない/一度もフル同期していない状態を表し、sync_all()(日次セーフティネット)の
  // フルスキャンのみでカバーされる。
  historyId       String?
  // users.watch()の有効期限。Google仕様上、登録・延長時点から最大7日。
  // watch_registration.renew_all_watches()が残り2日以内/未設定の担当者のみ延長する。
  watchExpiration DateTime?
}

// 連絡先とのメール送受信ログ(2026-08-16、Gmail連携移管)。Notion側はAPIレート制限・
// 件数の都合上生ログは持たず、連絡先ページには「最終メール日時」等のロールアップの
// みを書き込む(src/gmail_sync/参照)。gmailMessageIdでの重複排除はPython側で行う。
model EmailLog {
  id               String    @id @default(cuid())
  // Notion連絡先DB(3b4d8ea8-d4f3-808d-9853-d9cdd3de39ae)のpage_id。
  contactPageId    String
  contactEmail     String
  repEmail         String
  gmailMessageId   String    @unique
  direction        String // "inbound" | "outbound"
  subject          String?
  snippet          String?
  sentAt           DateTime
  createdAt        DateTime  @default(now())
  // インシデント・アクシデント検知(2026-08-16、src/incident_detection/)。
  // キーワード+重み付けスコアリングの合計スコアと優先度("high"|"medium"|"low")。
  // direction="outbound"や検知対象外(スコア0)のメールはどちらもnullのまま。
  incidentScore    Int?
  incidentPriority String?
  // 中優先度("medium")インシデントの日次ダイジェスト配信済み時刻(shirokuma-secレビューWARN
  // 対応、2026-08-16)。src/incident_detection/db.pyのclaim_undigested_medium_priority_emails()が
  // `UPDATE ... WHERE "digestedAt" IS NULL ... RETURNING`でアトミックに埋めてから返す
  // (email_reminders/db.pyのrecord_reminder_sent()と同じ「送信の権利を先にDB側でアトミックに
  // 獲得してから送る」設計)。Vercel Cronの実行タイミングのズレ・多重起動があっても、
  // 同じインシデントが二重にダイジェストへ載ったり、逆に一生載らず漏れたりしない。
  digestedAt       DateTime?

  reminderLogs EmailReminderLog[]

  @@index([contactPageId])
  @@index([contactEmail])
}

// データ監査ログ(2026-08-17、金沢さんからの「最終編集者・作成者・編集内容を記録したい」
// 要望対応)。Notionへの全書き込みが最終的に集約される共通層(HttpNotionClient.create_page/
// update_page、src/sync_engine/clients/notion_client.py)にフックして自動記録する
// (呼び出し元ごとに個別のログ呼び出しを仕込む方式は書き漏れリスクが高いため避けた設計)。
//
// 対象はこのバックエンド経由でのNotion書き込みのみ。Notion管理画面から人間が直接編集した
// 変更はこのコードを経由しないため捕捉できない(Notion自体にフィールド単位の変更履歴を
// 返すAPIが無いため技術的な制約として対象外)。
//
// このテーブルもEmailLog等と同様、書き込みはPython側(psycopg直接アクセス、
// src/audit_log/db.py)が行う。
model AuditLog {
  id            String   @id @default(cuid())
  // 対象Notion DB(src/db_schema/registry.pyのスキーマキー)。
  // "client_master" | "contact" | "project" | "action" | "product" | "chain" のいずれか。
  dbKey         String
  // 対象NotionページのID。
  notionPageId  String
  // "create" | "update"。
  action        String
  // プロパティ名 -> {"before": ..., "after": ...} の差分(update)、または初期値
  // (create、beforeは全てnull)。Notion APIの生JSON構造ではなく、シンプルな
  // 文字列/数値/配列等に変換済みの値を格納する(HttpNotionClient.get_page()と同じ変換)。
  changedFields Json
  // どの経路からの書き込みか。例: "kintone_webhook" | "zoho_webhook" | "spreadsheet_webhook" |
  // "gmail_sync" | "lead_inquiry_webhook" | "slack_interaction_webhook" | "migration" 等。
  actorSource   String
  // 人間が分かる識別子(可能な範囲で)。Webhook起因なら固定文字列、将来dashboard操作からの
  // 書き込みが追加された場合はログインユーザーのメール等を想定。
  actorLabel    String?
  createdAt     DateTime @default(now())

  @@index([dbKey])
  @@index([notionPageId])
  @@index([actorSource])
  @@index([createdAt])
}

// 案件管理DB(Notion、約10,000件)のPostgres複製(読み取り専用ミラー、2026-08-17)。
// 全社ダッシュボードでの`NotionDataSource.get_projects()`全件取得が実測約100秒かかる
// 問題への対応。データの正本は引き続きNotionであり、双方向同期パイプライン
// (Dispatcher/SyncEvent/IdMappingStore)には一切関与しない(ミラーが古くなっても実害は
// ダッシュボード表示の鮮度低下のみ)。
//
// 個別プロパティを列化せず`data`(Json)へ丸ごと保存する。PROJECT_SCHEMA(約40プロパティ)は
// 変更頻度が高く、列化するとNotion側のプロパティ追加のたびにdashboard側のマイグレーションが
// 必須になってしまうため(既存の消費者はSQL側のフィルタ・集計を必要としない)。
//
// このテーブルもAuditLog等と同様、書き込みはPython側(psycopg直接アクセス、
// src/project_mirror/db.py)が行う。
model ProjectMirror {
  id           String    @id @default(cuid())
  notionPageId String    @unique
  data         Json
  lastEditedAt DateTime?
  syncedAt     DateTime  @default(now())

  @@index([syncedAt])
}

// 取引先マスターDB(Notion)の正規化済み取引先名 → Notion page ID の高速検索用インデックス
// (2026-08-25、「ツール間のリレーション同期が構造的にリアルタイムでは行われていない」課題
// 対応)。ProjectMirrorと同じ設計思想: データの正本は引き続きNotionであり、このテーブルは
// kintone/Zoho Webhookが受け取る自由入力の会社名テキストから対応するNotion取引先マスター
// ページIDを、Notion APIを呼ばずローカルのPostgres検索のみで（Webhookの同期応答時間内に）
// 解決するためだけに存在する(src/relation_sync/resolve.py参照)。
//
// このテーブルもProjectMirror等と同様、書き込みはPython側(psycopg直接アクセス、
// src/relation_sync/db.py)が行う。
model ClientNameIndex {
  id           String @id @default(cuid())
  notionPageId String @unique
  // src/migration/notion_dedupe.pyのnormalize_company_name_strong()と同じロジックで正規化した
  // 取引先名(完全一致検索用、find_by_normalized_name()参照)。同じ正規化キーを持つ取引先が
  // 複数存在しうる(表記ゆれではなく実在する別会社が同名寄せされるケース)ため@uniqueにはせず
  // @@indexのみ張る。
  normalizedName String
  // 元の取引先名(デバッグ用)。
  rawName  String
  syncedAt DateTime @default(now())

  @@index([normalizedName])
}

enum RelationReviewStatus {
  pending
  resolved
  dismissed
}

// リレーション解決が曖昧(複数候補ヒット・候補なし)だった場合に、自動確定させず人の確認待ち
// として記録するキュー(2026-08-25)。src/migration/のneeds_review_clients(移行時、CSV+
// コンソール出力していた同種の判断)と同じ考え方を、リアルタイムのWebhook処理向けに永続化
// したもの。書き込みはPython側(src/relation_sync/review_queue.py)が行う。resolved/dismissed
// への遷移は今回のスコープでは手動SQL操作を前提とした最小限の実装(list_pending_reviews()の
// み用意)。
//
// 【DB上のみに存在するインデックス】(sourceTool, sourceRecordId, targetDbKey, rawValue)への
// 部分ユニークインデックス(status='pendingの行のみ対象)がmigration.sql
// (20260825060000_add_relation_sync)に存在する。同一内容の重複pending行を
// `INSERT ... ON CONFLICT ... DO NOTHING`でDB側から原子的に防ぐために使う
// (src/relation_sync/review_queue.pyのenqueue_for_review()参照、shirokuma-sec/
// obasan-qualityレビューWARN対応)。Prismaのスキーマ定義言語はフィルタ条件付き(部分)
// インデックスを表現できないため、このモデル定義には`@@unique`/`@@index`として現れない
// (schema.prismaとmigration.sqlの間の意図的な乖離。今後このモデルへ`prisma migrate dev`等で
// 新規マイグレーションを生成する場合、この部分インデックスを消してしまわないよう注意)。
model RelationReviewQueue {
  id             String @id @default(cuid())
  // "kintone" | "zoho" 等、解決を試みたレコードの出所ツール。
  sourceTool     String
  sourceRecordId String
  // 解決先DBのスキーマキー(例: "client_master"、src/db_schema/registry.py参照)。
  targetDbKey    String
  // 解決を試みた元の文字列(例: kintoneのclient_name列に入っていた会社名)。
  rawValue       String
  // 複数候補があった場合の候補Notion page ID一覧(候補なしの場合は空配列)。
  candidateNotionPageIds Json
  // candidateNotionPageIdsと同じ順序・同じ件数で対になる、各候補の取引先名(ClientNameIndex.
  // rawName)一覧(2026-08-25、shirokuma-sec/obasan-qualityレビューWARN対応)。
  // scripts/list_relation_review_queue.pyがpage IDの羅列だけでなく会社名も表示できるように
  // するため、find_by_normalized_name()が返すraw_nameを捨てずに保持する。
  candidateRawNames      String[]             @default([])
  status                 RelationReviewStatus @default(pending)
  createdAt              DateTime             @default(now())
  resolvedAt             DateTime?
  resolvedNotionPageId   String?

  @@index([status])
  @@index([sourceTool])
}

// 見積書 承認フロー(Google Drive Approvals連携、営業担当者個人OAuth方式、2026-08-18)。
//
// サービスアカウント(GOOGLE_SERVICE_ACCOUNT_JSON、ドメイン全体委任なし)ではDrive
// Approvals APIのcanStartApprovalがfalseであることを実機検証済みのため、RepGmailConnection
// と全く同じ「個人OAuth同意」方式を採用する(経緯は計画書「認証方式の紆余曲折」参照)。
// スコープはGmail連携(gmail.readonly)より広いdrive(読み書き)。
model RepDriveConnection {
  id              String   @id @default(cuid())
  repEmail        String   @unique
  refreshTokenEnc String
  connectedAt     DateTime @default(now())
}

// 見積書の承認者候補(平本さん・黒井さん等、案件ごとに選択する)。管理はこのdashboard側の
// Prisma CRUDで完結し(RepGmailConnection等と異なりPythonバックエンド側は読み書きしない
// ——承認リクエスト送信時は選択済みのapprover_emailのみがPython側へ渡される)、
// app/(dashboard)/settings/document-approvers/で管理者が編集する。
model DocumentApprover {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  title     String? // 役職(例: マーケティング本部長)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

// 見積書の承認リクエスト1件ごとの状態(2026-08-18)。スキーマ管理はこのPrismaに一本化し、
// 実際の読み書きはPython側(src/document_generation/approval_db.py、psycopg直接アクセス、
// AuditLog等と同じ方針)が行う。categoryを文字列にしているのは、将来「申込書」「契約書」にも
// 同じ仕組みを広げやすくするため(今回のスコープは見積書のみ)。
model DocumentApproval {
  id               String    @id @default(cuid())
  notionProjectId  String
  category         String
  driveFileId      String
  driveApprovalId  String
  approverEmail    String
  // 承認リクエストを送った営業担当者のメール(RepDriveConnection.repEmailと対応)。
  requestedByEmail String
  // "in_progress" | "approved" | "declined" | "cancelled"
  status           String
  createdAt        DateTime  @default(now())
  resolvedAt       DateTime?

  @@index([status])
  @@index([notionProjectId])
}

// 見積書NOの当日発行連番(2026-08-19、正式採番ルール「CN{YYYYMMDD}{作成者頭文字1字}
// {当日発行連番2桁}」対応、例: CN20260819K01)。datePrefixは"YYYYMMDD"文字列（JST基準）。
// 実際の読み書きはPython側(src/document_generation/quote_number_db.py)が
// INSERT...ON CONFLICT DO UPDATE...RETURNINGで原子的にインクリメントする
// (DocumentApproval等と同じraw SQL直接アクセスの方針)。
model QuoteNumberSequence {
  datePrefix String @id
  lastSeq    Int    @default(0)
}
