# 容量照合・共有scope作成・自動drain準備・全配備切替が終わるまで無効のまま。
SYNC_CAPACITY_ENABLED=false
SYNC_CAPACITY_FIRESTORE_PROJECT=
SYNC_CAPACITY_FIRESTORE_DATABASE=(default)
# 同じPostgresを使う全配備で一致させる。環境別suffixで分割しない。
SYNC_CAPACITY_SCOPE=
# 実測した接続予算から決める。既定の安全値はない。
SYNC_CAPACITY_SLOTS=
# Firestore認証は実行サービスアカウントのADC。鍵ファイル・秘密は本ファイルに書かない。
