# Notion（マスターDB）
NOTION_API_KEY=
# 本番一括投入(scripts/migrate_data.py)の並列書き込み高速化用の追加インテグレーション
# （任意）。NOTION_API_KEY_2, _3, _4...の順で追加すると自動検出され、それぞれ別トークン
# として並列に書き込む（例: 4個追加なら主トークン含め5並列）。各トークンは対象6DB全てに
# Notion側の「Connections」で共有しておくこと。1つも設定しなければ単一トークン・
# 逐次実行のまま（従来通り）。
# NOTION_API_KEY_2=
# scripts/setup_notion_databases.py でDBを作成する先の親ページID
NOTION_PARENT_PAGE_ID=
# webhook_handlers/notion_webhook.py: Webhook認証用の共有シークレット（BLOCKER7暫定実装）
NOTION_WEBHOOK_SECRET=

# kintone（既存業務DB）
KINTONE_DOMAIN=
KINTONE_API_TOKEN_CLIENT=
KINTONE_API_TOKEN_PROJECT=
KINTONE_API_TOKEN_ACTION=
# kintone_webhook.py: Webhookペイロードのapp.idからDBを逆引きするためのアプリID
KINTONE_APP_ID_CLIENT=
KINTONE_APP_ID_PROJECT=
KINTONE_APP_ID_ACTION=
# webhook_handlers/kintone_webhook.py: Webhook認証用の共有シークレット（BLOCKER7暫定実装）。
# kintoneのWebhook設定画面はカスタムHTTPヘッダーを送信できないため、他ツールと異なり
# ヘッダーではなくWebhook URLのクエリパラメータ（?secret=...）で検証する
# （verify_webhook_query_param()、docs/kintone_webhook_activation_note.md参照）。
KINTONE_WEBHOOK_SECRET=

# Zoho CRM（過渡期CRM。False にすると疎結合で完全に切り離せる）
ENABLE_ZOHO=True
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
# webhook_handlers/zoho_webhook.py: Webhook認証用の共有シークレット（BLOCKER7暫定実装）
ZOHO_WEBHOOK_SECRET=
# sync_engine/zoho_watch_channel.py: Zoho Notifications(watch)チャンネルの自動延長
# （api/cron/zoho-webhook-renewal）が延長対象を特定するために読む、現在有効なchannel_id。
# scripts/register_zoho_webhook.py --yes で新規登録するたびに出力される
# ZOHO_WATCH_CHANNEL_ID=... の値を、ここ（および実際にはVercel本番環境変数）へ反映すること。
# 未設定のままcronが実行されると、延長は行われず明確なエラーとして失敗する（no-opにしない）。
ZOHO_WATCH_CHANNEL_ID=
# 同上のcronが延長リクエストのnotify_urlを組み立てるためのデプロイベースURL
# （例: https://crm-sfa-integration.vercel.app）。scripts/register_zoho_webhook.pyの
# --base-url引数と同じ役割。
ZOHO_WEBHOOK_BASE_URL=

# Eight（名刺連携）
EIGHT_API_KEY=

# Google スプレッドシート
GOOGLE_SERVICE_ACCOUNT_JSON=
SPREADSHEET_ID=
# clients/spreadsheet_client.py: 本番運用ではGOOGLE_SERVICE_ACCOUNT_JSONからの
# トークン取得・自動リフレッシュ処理（document_generation/google_auth.py）を使う（対応済み）。
# GOOGLE_ACCESS_TOKENはローカル動作確認向けのフォールバック（任意・上記が未設定時のみ参照）で、
# 有効なOAuth2アクセストークン（通常1時間程度で失効）を手動で払い出して直接設定する。
GOOGLE_ACCESS_TOKEN=
# webhook_handlers/spreadsheet_webhook.py: Webhook認証用の共有シークレット（BLOCKER7暫定実装）
SPREADSHEET_WEBHOOK_SECRET=

# Slack通知
SLACK_WEBHOOK_URL_ALERT=
SLACK_WEBHOOK_URL_REPORT=

# calendar_sync: 案件管理DBの「次回アクション日」変更をweb-engagement-tool側の
# Google Calendar連携API (POST /api/calendar/events) へ同期する
WEB_ENGAGEMENT_TOOL_URL=
CALENDAR_SYNC_API_TOKEN=
# lead_sync/web_engagement_tool_client.py: 連絡先DB（Contact）の作成・更新をweb-engagement-tool側
# のリード管理API (POST /api/leads/sync) へ同期する。WEB_ENGAGEMENT_TOOL_URLを共用し、
# web-engagement-tool側のCRM_SFA_SYNC_API_TOKENと対になる値。
CRM_SFA_SYNC_API_TOKEN=
# webhook_handlers/web_engagement_webhook.py: web-engagement-tool側からのリードの
# ホットリード化・新規識別通知(POST /api/webhooks/web-engagement)のWebhook認証用共有シークレット
# （BLOCKER7暫定実装と同じ共有トークン方式。web-engagement-tool側のCRM_SFA_WEBHOOK_SECRET/
# CRM_SFA_WEBHOOK_URL（送信先として本エンドポイントのURLを指す）と対になる値）。
WEB_ENGAGEMENT_WEBHOOK_SECRET=

# web_engagement_meeting_webhook.py: web-engagement-tool側からのGoogleカレンダー商談イベント
# 通知(POST /api/webhooks/web-engagement-meeting)のWebhook認証用共有シークレット
# （WEB_ENGAGEMENT_WEBHOOK_SECRETとはスコープを分離。web-engagement-tool側の
# CRM_SFA_MEETING_WEBHOOK_SECRET/CRM_SFA_MEETING_WEBHOOK_URLと対になる値）。
WEB_ENGAGEMENT_MEETING_WEBHOOK_SECRET=
# webhook_handlers/lead_inquiry_webhook.py: lead-researcher（別リポジトリ、問い合わせメール
# 自動調査Slackボット）からのリード情報通知(POST /api/webhooks/lead-inquiry)のWebhook認証用
# 共有シークレット。lead-researcher側の同名の値と対になる。
LEAD_RESEARCHER_WEBHOOK_SECRET=
# meeting_sync/matcher.py・gmail_sync/sync.py: カレンダーイベント参加者・メール送受信者から
# 自社(内部)ドメインを除外するためのカンマ区切りドメインリスト。営業担当自身のメール
# アドレスを「先方」として連絡先DB検索にかけないようにする。
INTERNAL_EMAIL_DOMAINS=cnctor.jp

# gmail_sync/: Gmail連携移管(2026-08-16、web-engagement-tool側から自前ポーリングへ移管)。
# RepGmailConnection.refreshTokenEncの暗号化・復号に使うAES-256-GCM鍵(32byte hex)。
# dashboard(Next.js)側のTOKEN_ENCRYPTION_KEYと**同じ値**を設定すること(暗号文を
# 両言語間で読み書きするため)。生成: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=
# gmail_sync/db.py: RepGmailConnection/EmailLogテーブルを持つNeon Postgresの接続文字列。
# dashboard(Next.js)側の同名環境変数と同じ値(同一DB)。
DATABASE_URL=
# gmail_sync/gmail_client.py: crm-sfa-integration専用のGoogle OAuthクライアント
# (web-engagement-tool側のGOOGLE_OAUTH_CLIENT_ID/_SECRETとは別アプリ)。
# 営業担当のGmail連携フロー(dashboard側で実装)で発行されるリフレッシュトークンを
# 使ってアクセストークンを更新する際に使う。
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# gmail_sync/notify.py: 連絡先DBとメアド一致したメールの送受信をweb-engagement-tool側へ
# 通知するWebhook(POST /api/webhooks/crm-sfa-email)の送信先URL・認証用共有シークレット。
# web-engagement-tool側の同名の値と対になる。未設定でも同期処理自体は継続する
# (MA側連携はあくまで副次的な効果のため)。
WEB_ENGAGEMENT_EMAIL_WEBHOOK_URL=
WEB_ENGAGEMENT_EMAIL_WEBHOOK_SECRET=
# gmail_sync/watch_registration.py・GET /api/cron/gmail-watch-renewal: Gmail Push通知
# (users.watch() + Cloud Pub/Sub)によるほぼリアルタイム同期用。Google Cloud Console側で
# 作成済みのPub/Subトピックのフルリソース名(例:
# projects/actionpoint-autocalc/topics/gmail-notifications)。トピック作成・Gmail用
# サービスアカウント(gmail-api-push@system.gserviceaccount.com)へのPublisher権限付与・
# push subscription作成はGoogle Cloud Console側での手動作業(コード側では自動化しない)。
GMAIL_PUBSUB_TOPIC_NAME=
# POST /api/webhooks/gmail-push: 上記push subscriptionのpush先URLに
# `?token=<この値>`を付与して検証する共有シークレット(kintone Webhookと同じクエリ
# パラメータ方式、詳細はsrc/sync_engine/webhook_handlers/_common.pyの
# verify_webhook_query_param()参照)。生成: openssl rand -hex 16
GMAIL_PUBSUB_VERIFICATION_TOKEN=
# meeting_sync/slack_approval.py: Googleカレンダー予定から検知した商談アイテムの承認依頼を
# 担当営業へDMで送るSlack Bot Token。web-engagement-tool側のSLACK_BOT_TOKEN
# （score alert通知用）とは別リポジトリ・別用途のため独立して設定する。
# 必要スコープ: chat:write（メッセージ送信）、users:read.email（メールアドレスから
# SlackユーザーIDを解決）、im:write（DMチャンネルを開く）。
SLACK_BOT_TOKEN=
# slack_interaction_webhook.py: Slack interactivity（ボタン押下コールバック、
# POST /api/webhooks/slack-interactions）の署名検証用Signing Secret。Slack App管理画面
# （api.slack.com/apps）のBasic Informationページから取得する。Interactivity & Shortcutsの
# Request URLに上記エンドポイントのURLを設定しておく必要がある（手動設定、コードでは自動化不可）。
SLACK_SIGNING_SECRET=

# 同期エンジン内部
SYNC_SYSTEM_ID=自社CRM-Engine
# webhook_handlers/_common.py: verify_webhook_secret()の挙動（fail-closedがデフォルト）。
# 対応する*_WEBHOOK_SECRETが未設定のWebhookリクエストを通過させたいローカル開発時のみ
# 明示的にTrueへ変更すること。本番では必ずFalseのままにし、各*_WEBHOOK_SECRETを設定すること。
ALLOW_UNSIGNED_WEBHOOKS=False
# sync_engine/production_wiring.py: IDマッピングストア（SQLite）の永続化先。Vercelの
# サーバーレス実行環境では/tmp配下以外は書き込めない（かつ/tmpもコンテナ間で永続化
# されない）ため、未設定時は暫定的に/tmp/sync_id_mapping.dbを使う。
SYNC_ID_MAPPING_DB_PATH=

# Vercel Cron（定期実行バッチ）
# api/cron/daily-batch, api/cron/zoho-webhook-renewal: VercelがCron Job実行時に自動付与する
# Authorization: Bearerヘッダーの照合用シークレット。Vercelプロジェクトの環境変数に
# CRON_SECRETを設定しておくと、Vercel側が自動的にこのヘッダーを付与する
# （手動でのWebhook等URL直叩きからの不正実行を防ぐ）。
CRON_SECRET=
# src/reports/batch.py: 月次・クオーター目標値（10_保留・要確認事項Q-05が未確定のため、
# Notion側に保持するプロパティが無く暫定的に環境変数で管理する）。未設定時は0（進捗率は
# 目標未設定として表示される）。
MONTHLY_TARGET_INITIAL_FEE=
MONTHLY_TARGET_MRR=
QUARTER_TARGET_INITIAL_FEE=
QUARTER_TARGET_MRR=
